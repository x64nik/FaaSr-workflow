{
    "ActionList": {
        "start": {
            "Arguments": {
                "folder": "tutorial-k8s",
                "output1": "sample1.csv",
                "output2": "sample2.csv"
            },
            "InvokeNext": [
                "sum"
            ],
            "FaaSServer": "K8s",
            "Type": "R",
            "FunctionName": "create_sample_data"
        },
        "sum": {
            "FunctionName": "compute_sum",
            "FaaSServer": "K8s",
            "Type": "R",
            "Arguments": {
                "folder": "tutorial-k8s",
                "input2": "sample2.csv",
                "input1": "sample1.csv",
                "output": "sum.csv"
            },
            "InvokeNext": []
        }
    },
    "ComputeServers": {
        "K8s": {
            "FaaSType": "Kubernetes",
            "Endpoint": "https://192.168.0.152:6443",
            "Namespace": "faasr",
            "UseSecretStore": true,
            "AllowSelfSignedCertificate": true,
            "SSLCertificate": "",
            "MaxCPU": 500,
            "MaxMemory": 1000,
            "TimeLimit": 300,
            "AdditionalTimeToLive": 3600,
            "NumberOfRetries": 0
        }
    },
    "DataStores": {
        "S3": {
            "Endpoint": "https://play.min.io",
            "Bucket": "faasr",
            "Region": "us-east-1"
        }
    },
    "ActionContainers": {
        "start": "faasr/kubernetes-r:latest",
        "sum": "faasr/kubernetes-r:latest"
    },
    "FunctionInvoke": "start",
    "DefaultDataStore": "S3",
    "FunctionGitRepo": {
        "create_sample_data": "FaaSr/FaaSr-Functions/tutorial",
        "compute_sum": "FaaSr/FaaSr-Functions/tutorial"
    },
    "LoggingDataStore": "S3",
    "FaaSrLog": "FaaSrLog",
    "InvocationID": "tutorial",
    "WorkflowName": "tutorial-k8s"
}